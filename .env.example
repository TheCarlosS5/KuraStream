# App
PORT=3000
# REQUIRED. Random secret of at least 32 characters; the server refuses to start with a weak one.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kurastream
DB_USER=kurastream
DB_PASS=change_me
MYSQL_ROOT_PASSWORD=change_me

# Administrator
ADMIN_USER=admin
# Set ADMIN_PASS_HASH (bcrypt, recommended) or a strong ADMIN_PASS. Placeholder values such as
# "change_me" or "admin" are rejected and disable the environment administrator login.
ADMIN_PASS=
# ADMIN_PASS_HASH=

# Sign-up: "open" (default) lets anyone who can reach the server create an account; any other value closes it.
# REGISTRATION_MODE=open
# New accounts allowed per address per hour (behind a reverse proxy also set TRUSTED_PROXIES).
# REGISTER_MAX_PER_HOUR=5
# Scales the per-address request limits (logins, comments...). Leave at 1 unless many devices share one address
# or you are running tests/load.
# RATE_LIMIT_MULTIPLIER=1

# Catalog browsing: guests can browse by default; "members" requires a signed-in session for the catalog,
# episodes, calendar and comments.
# CATALOG_ACCESS=open

# Metadata
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Library
MEDIA_LIBRARY_PATH=./library

# Network / proxy
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=

# Time zone for calendar weekdays (default UTC), e.g. America/Bogota
APP_TIMEZONE=America/Bogota

# Background worker / jobs: auto (queue when the worker runs), queue, inline (never queue)
# JOBS_MODE=auto
# Parallel ffmpeg transcodes (default: half the CPU cores, at least 2)
# TRANSCODE_MAX_WORKERS=
# Database backups made by the worker: folder and how many to keep
# BACKUP_DIR=./backups
# BACKUP_KEEP=7

# Docker resource limits (docker-compose.yml). Raise APP_MEM_LIMIT if many people transcode at the same time.
# APP_MEM_LIMIT=4g
# WORKER_MEM_LIMIT=2g
# MYSQL_MEM_LIMIT=2g
# NGINX_MEM_LIMIT=256m
