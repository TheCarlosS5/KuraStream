# App
PORT=3000
# REQUIRED. Random secret of at least 32 characters; the server refuses to start with a weak one.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kurastream
DB_USER=kurastream
DB_PASS=change_me
MYSQL_ROOT_PASSWORD=change_me

# Administrator
ADMIN_USER=admin
# Set ADMIN_PASS_HASH (bcrypt, recommended) or a strong ADMIN_PASS. Placeholder values such as
# "change_me" or "admin" are rejected and disable the environment administrator login.
ADMIN_PASS=
# ADMIN_PASS_HASH=

# Metadata
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Library
MEDIA_LIBRARY_PATH=./library

# Network / proxy
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=

# Time zone for calendar weekdays (default UTC), e.g. America/Bogota
APP_TIMEZONE=America/Bogota
