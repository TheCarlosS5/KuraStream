# KuraStream - nginx front end (nginx + PHP-FPM)
#
# This is a template: scripts/render_deploy.sh (Debian) and the nginx container (Docker, /etc/nginx/templates)
# replace the KURA_* placeholders and leave nginx's own $variables alone. It lives in the http context
# (conf.d/), so it can declare upstreams.
#
#   KURA_PORT              port to listen on (3000 keeps the old address working)
#   KURA_APP_DIR           the project directory as PHP sees it (frontend/ is served from here)
#   KURA_LIBRARY_DIR       the media library (same absolute path inside the nginx and the PHP container)
#   KURA_API_UPSTREAM      PHP-FPM "api" pool   (unix:/run/php/kurastream-api.sock  or  app:9000)
#   KURA_STREAM_UPSTREAM   PHP-FPM "stream" pool (video, SSE, uploads: long requests)

upstream kura_api {
    server ${KURA_API_UPSTREAM};
}
upstream kura_stream {
    server ${KURA_STREAM_UPSTREAM};
}

server {
    listen ${KURA_PORT} default_server;
    server_name _;
    server_tokens off;

    root ${KURA_APP_DIR}/frontend;
    index index.html;
    charset utf-8;

    # Small bodies everywhere; the few upload endpoints below raise it. (PHP's own post_max_size used to be 4 GB for
    # every URL, so anybody could send gigabytes to any address.)
    client_max_body_size 1m;
    client_body_timeout 60s;
    send_timeout 120s;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json
               image/svg+xml application/wasm font/ttf font/otf;

    # --- every PHP location shares these FastCGI parameters (inherited: none of them defines its own) ----------
    include fastcgi_params;
    set $kura_router ${KURA_APP_DIR}/php_backend/router.php;
    fastcgi_param SCRIPT_FILENAME $kura_router;
    fastcgi_param SCRIPT_NAME /php_backend/router.php;
    fastcgi_param HTTPS $https if_not_empty;
    fastcgi_intercept_errors off;
    fastcgi_connect_timeout 5s;

    # Optional extras (TLS, see deploy/README.md): any *.conf dropped in this directory joins the server block.
    include kurastream.d/*.conf;

    # --- the web app (frontend/) ----------------------------------------------------------------------------------
    # PHP used to serve these too, with the security headers; nginx adds the same ones (security-headers.conf is
    # generated from config.php). Scripts and styles are revalidated on every load (cheap 304 thanks to ETag):
    # the hashed, immutable build of Phase 4 will let them be cached for good.
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
        include ${KURA_APP_DIR}/deploy/nginx/security-headers.conf;
    }

    location / {
        try_files $uri @kura_api;
        add_header Cache-Control "no-cache" always;
        include ${KURA_APP_DIR}/deploy/nginx/security-headers.conf;
    }

    location ~* \.(?:png|jpe?g|webp|gif|svg|ico|woff2?|ttf|otf|wasm)$ {
        try_files $uri @kura_api;
        add_header Cache-Control "public, max-age=86400" always;
        include ${KURA_APP_DIR}/deploy/nginx/security-headers.conf;
    }

    location ~ /\. {
        deny all;
    }

    # --- artwork under /library/: images straight from disk, everything else (loops, presets, fallbacks) via PHP ----
    location ~* ^/library/(.+\.(?:jpe?g|png|webp|gif))$ {
        alias ${KURA_LIBRARY_DIR}/$1;
        add_header Cache-Control "public, max-age=3600" always;
        include ${KURA_APP_DIR}/deploy/nginx/security-headers.conf;
        error_page 404 = @kura_api;
    }

    location /library/ {
        fastcgi_pass kura_api;
    }

    # --- the API ----------------------------------------------------------------------------------------------------
    location /api/ {
        fastcgi_pass kura_api;
        fastcgi_read_timeout 120s;
        fastcgi_send_timeout 120s;
    }

    # Watch Party event stream (SSE): never buffered, lives as long as the viewer stays in the room.
    location = /api/party/stream {
        fastcgi_pass kura_stream;
        fastcgi_buffering off;
        fastcgi_read_timeout 3700s;
        fastcgi_send_timeout 3700s;
        gzip off;
    }

    # Video. PHP only authorizes a direct play (X-Accel-Redirect below); a live remux/transcode is a long response.
    location /api/stream/ {
        fastcgi_pass kura_stream;
        fastcgi_buffering off;
        fastcgi_read_timeout 6h;
        fastcgi_send_timeout 6h;
        gzip off;
    }

    # Administration and imports: large uploads (episodes), long-running requests.
    location ^~ /api/admin/ {
        fastcgi_pass kura_stream;
        client_max_body_size 4g;
        fastcgi_request_buffering off;
        fastcgi_read_timeout 1h;
        fastcgi_send_timeout 1h;
    }
    location = /api/import {
        fastcgi_pass kura_stream;
        client_max_body_size 4g;
        fastcgi_request_buffering off;
        fastcgi_read_timeout 1h;
        fastcgi_send_timeout 1h;
    }

    # --- media files: only reachable through an X-Accel-Redirect from PHP (after authorization) ---------------------
    location /_media/ {
        internal;
        alias ${KURA_LIBRARY_DIR}/;
        sendfile on;
        tcp_nopush on;
        gzip off;
    }

    location @kura_api {
        fastcgi_pass kura_api;
        fastcgi_read_timeout 120s;
    }
}
